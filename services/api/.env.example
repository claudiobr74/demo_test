# SerenaPsi API — desenvolvimento local
ENVIRONMENT=development
APP_NAME=SerenaPsi API
APP_VERSION=0.1.0
API_PREFIX=/api/v1
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://serenapsi:serenapsi@localhost:5432/serenapsi
DATABASE_URL_SYNC=postgresql://serenapsi:serenapsi@localhost:5432/serenapsi

# Auth (trocar em produção — nunca commitar segredos reais)
JWT_SECRET=dev-only-change-me-serenapsi-jwt-secret-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Segurança
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:8080
BCRYPT_ROUNDS=12

# IA — modelos configuráveis por ambiente (nunca hardcode no app)
AI_ENABLED=false
AI_FAST_MODEL=openai:gpt-4o-mini
AI_REASONING_MODEL=openai:gpt-4o
AI_DEEP_REASONING_MODEL=openai:o1
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Observabilidade
LOG_LEVEL=INFO
LOG_JSON=false
